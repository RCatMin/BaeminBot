# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore에 걸려 있어서 깃에 올라가지 않습니다.
# 토큰 발급 방법은 SETUP.md 를 보세요.

# Slack App 설정 > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-

# Slack App 설정 > Basic Information > App-Level Tokens (connections:write 권한)
SLACK_APP_TOKEN=xapp-

# (선택) 슬래시 커맨드 이름을 바꿨다면 여기에 적으세요. 쉼표로 여러 개 가능.
# 안 적으면 기본값: /배달  ·  /계좌등록  ·  /외식  ·  /내기빵
# SLACK_LUNCH_COMMANDS=/배달
# SLACK_ACCOUNT_COMMANDS=/계좌등록
# SLACK_DINE_OUT_COMMANDS=/외식
# SLACK_BET_COMMANDS=/내기빵
